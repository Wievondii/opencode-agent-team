{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "C:\\opencode-agent-team"
  ],
  "agent": {
    "pm": {
      "mode": "primary",
      "model": "xiaomi-token-plan-sgp/mimo-v2.5-pro",
      "description": "项目经理 - 协调Agent Team开发流程",
      "temperature": 0.2,
      "color": "#4F46E5"
    },
    "planner": {
      "mode": "subagent",
      "model": "xiaomi-token-plan-sgp/mimo-v2.5-pro",
      "description": "策划师 - 分析需求制定开发计划",
      "temperature": 0.2
    },
    "developer": {
      "mode": "subagent",
      "model": "xiaomi-token-plan-sgp/mimo-v2.5-pro",
      "description": "开发者 - 编写代码修复bug",
      "temperature": 0.3
    },
    "reviewer": {
      "mode": "subagent",
      "model": "xiaomi-token-plan-sgp/mimo-v2.5-pro",
      "description": "审查员 - 代码审查并提交",
      "temperature": 0.2
    },
    "tester": {
      "mode": "subagent",
      "model": "xiaomi-token-plan-sgp/mimo-v2.5",
      "description": "测试员 - 功能测试Bug报告",
      "temperature": 0.2
    }
  }
}
